{
  "name": "@soumendudas22/dsh-turn-timeline",
  "version": "1.0.1",
  "description": "DeepSeek Harness (DSH) plugin that shows each chat turn's reasoning and tool calls as a timeline, with a rail and live status dots.",
  "keywords": ["dsh", "deepseek-harness", "dsh-plugin", "cordis", "timeline", "chat"],
  "homepage": "https://github.com/soumendudas22/dsh-turn-timeline#readme",
  "bugs": { "url": "https://github.com/soumendudas22/dsh-turn-timeline/issues" },
  "repository": { "type": "git", "url": "git+https://github.com/soumendudas22/dsh-turn-timeline.git" },
  "license": "MIT",
  "author": "soumendudas22 <soumendudas22@gmail.com>",
  "type": "module",
  "main": "./index.js",
  "scripts": { "test": "node scripts/check.mjs" },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-chat", "@deepseek-ai/dsh-client-ui-tool"]
    }
  },
  "publishConfig": { "access": "public" }
}
